{
  "name": "@deepseek-ai/dsh-compat-shim",
  "version": "0.1.3-alpha.1",
  "description": "DSH Compatibility Shim Plugin: backward-compatible apiProxy (host) and conversationEvents (client) service faces for old plugins on newer hosts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./invariant": "./lib/invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
